ENCRYPTION_MASTER_KEY=your-256-bit-master-key
API_GATEWAY_SECRET=your-api-gateway-secret

# ==============================================================================
# MONITORING & LOGGING
# ==============================================================================
SENTRY_DSN=https://your-sentry-dsn
DATADOG_API_KEY=your-datadog-api-key
LOGZIO_TOKEN=your-logzio-token

# ==============================================================================
# DEVELOPMENT FLAGS
# ==============================================================================
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=info
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=100
# ==============================================================================
# CODE SIGNING CERTIFICATES
# ==============================================================================
# macOS Code Signing
MAC_CERT_PASSWORD=your_mac_developer_id_cert_password
MAC_INSTALLER_CERT_PASSWORD=your_mac_installer_cert_password
APPLE_ID=your_apple_id@example.com
APPLE_APP_SPECIFIC_PASSWORD=your_app_specific_password
